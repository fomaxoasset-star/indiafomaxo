# admin.css, admin.js and vshrink.js: kept by the browser for a year. Their address carries ?v= from the file itself (asset_v in index.php),
# so a changed file gets a new address and is fetched straight away. Pages and alert-sw.js are not cached.
<IfModule mod_headers.c>
  <FilesMatch "^(admin\.(css|js)|vshrink\.js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
