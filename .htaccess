# FOMAXO: speed settings for the web server (Hostinger LiteSpeed / Apache).

# Send text files compressed.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>

# Let browsers keep photos and fonts. index.html builds every photo link with ?v=N,
# so bump that number when a photo file is replaced and browsers fetch the new one.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# The page itself is always checked again, so a new version shows straight after a deploy.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Real addresses for Google: /product/<id> and /sitemap.xml are answered by api/seo.php (the shop still runs on #/… inside).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^product/([a-z0-9-]{1,48})/?$ api/seo.php?p=product&id=$1 [L,QSA]
  RewriteRule ^sitemap\.xml$ api/seo.php?p=sitemap [L]
</IfModule>
