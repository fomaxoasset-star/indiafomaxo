# FOMAXO: speed settings for the web server (Hostinger LiteSpeed / Apache).

# Keep the shop's own working files private: setup notes (.md, .txt except robots.txt), example settings,
# data and backup files, old homepage copies (index-2.html …) and hidden dot-files such as .gitignore.
# The site and admin read these on the server, never through the browser, so nothing visible changes.
<FilesMatch "(?i)(^\.|\.(md|bak|old|orig|sql|sqlite|db|log|zip|sh|ini|json|csv)$|^(?!robots\.txt$).*\.txt$|^index-\d+\.html?$|\.example\.php$|-lib\.php$)">
  Require all denied
</FilesMatch>

# video shrink helper (admin): the converter file must be served as WebAssembly
AddType application/wasm .wasm
# the site's own text fonts (assets/fonts)
AddType font/woff2 .woff2

# Send text files compressed.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>

# Let browsers keep photos and fonts. index.html builds every photo link with ?v=N,
# so bump that number when a photo file is replaced and browsers fetch the new one.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  # shop videos (media/v, a new file name for every upload)
  ExpiresByType video/mp4 "access plus 1 month"
  ExpiresByType video/quicktime "access plus 1 month"
  ExpiresByType video/webm "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Photos, fonts and videos never change at the same address (photos and fonts carry ?v=N, uploads get a new name), so the browser need not
# check them again even on a reload: Safari otherwise asks the server about every picture each time the page is reloaded.
<IfModule mod_headers.c>
  <FilesMatch "\.(webp|jpe?g|png|svg|woff2|mp4|webm|mov)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# The page itself is always checked again, so a new version shows straight after a deploy.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Real addresses for Google: /fomaxo-<name> (e.g. /fomaxo-gold, as on fomaxo.com), /product/<id> and /sitemap.xml are answered by api/seo.php (the shop still runs on #/… inside).
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Link preview picture: Instagram / Facebook show a square, so their link reader gets the square version
  # (WhatsApp and everyone else get the wide 1200x630 one at the same address), as on fomaxo.com.
  RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|Instagram|meta-externalagent|Facebot) [NC]
  RewriteRule ^assets/img/link-preview\.jpg$ assets/img/link-preview-square.jpg [L]
  RewriteRule ^product/([a-z0-9-]{1,48})/?$ api/seo.php?p=product&id=$1 [L,QSA]
  # Pictures uploaded on the admin page (media/p) and review photos (media/r): the web server sends its own copy; a picture with no copy
  # yet goes to PHP once, which makes it (api/pub-lib.php). Before, every such picture held a PHP process while it downloaded.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^media/p/([a-z0-9-]{1,48}-[a-f0-9]{8}\.(webp|jpg))$ api/live.php?img=$1 [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^media/r/([a-f0-9]{24}\.jpg)$ api/reviews.php?action=photo&f=$1 [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^fomaxo-([a-z0-9-]{1,80})/?$ api/seo.php?p=name&id=$1 [L,QSA]
  RewriteRule ^sitemap\.xml$ api/seo.php?p=sitemap [L]
  # product list for free Google Shopping listings (Merchant Center), and the Returns page at its own address
  RewriteRule ^google-shopping\.xml$ api/seo.php?p=feed [L]
  # Google's site check file (Merchant Center / Search Console → "HTML file"): its name is pasted on Admin → Settings → Ads, nothing to upload
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^(google[a-z0-9]{6,40}\.html)$ api/seo.php?p=gsv&f=$1 [L]
  RewriteRule ^returns/?$ api/seo.php?p=returns [L,QSA]
  RewriteRule ^faq/?$ api/seo.php?p=faq [L,QSA]
</IfModule>

# The link preview picture changes with the reader (see above), so caches keep one copy per reader, for an hour.
<FilesMatch "^link-preview(-square)?\.jpg$">
  <IfModule mod_headers.c>
    Header set Vary "User-Agent"
    Header set Cache-Control "public, max-age=3600"
  </IfModule>
</FilesMatch>
